{
  "manifest_version": 3,
  "name": "AeroGrab",
  "version": "4.1",
  "minimum_chrome_version": "102",
  "description": "Sends your browser downloads and videos to AeroGrab, a fast and private download manager.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open AeroGrab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:9999/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "tracker.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}